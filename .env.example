# Copy this file to `.env` and fill in real values.
# Never commit the actual `.env` — only this template.

SECRET_KEY=change-this-to-a-long-random-string

# SMTP — Gmail App Password (not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-project-mail@gmail.com
SMTP_PASS=your-16-char-app-password-here
SMTP_FROM=your-project-mail@gmail.com
MAIL_DEV_MODE=false

# Database — leave blank for SQLite
DATABASE_URL=